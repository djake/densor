# Copy to /etc/densor.env on the Pi (sudo, mode 600, owner root) and fill in the key.
# Never commit the real file.
S3_BUCKET=densor
# One prefix per Pi: densor-<site>
S3_PREFIX=densor-ch
S3_ENDPOINT=https://t3.storage.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
# Only needed if uploads are rejected by the store:
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required
