# Copy to notebooks/.env (gitignored) and fill in a READ-ONLY Tigris key.
# Do not reuse the Pi's write key here.
S3_BUCKET=densor
# site=prefix pairs, one prefix per Pi
S3_SITES=ch=densor-ch,sr=densor-sr
# Temperature unit for plots: F (default) or C. Readings are stored in Celsius.
TEMP_UNIT=F
S3_ENDPOINT=t3.storage.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
# Optional: read a local copy of the bucket layout instead of S3.
# DENSOR_LOCAL_DIR=/path/to/dir/containing/one/folder/per/prefix (each with readings/ and devices.json)
# Optional live tail over SSH (ZeroTier addresses); leave unset to read the bucket only.
# DENSOR_LIVE=ch=densor@10.163.114.13,sr=densor@10.163.114.239
# Live readings are cached on disk so reloading within the window does not SSH again.
# DENSOR_LIVE_TTL=600            seconds to reuse the cached live readings (default 600)
# DENSOR_IGNORE=                 comma-separated sensor names or IEEE addresses to drop from every notebook
# DENSOR_KEEP_UNNAMED=0          1 keeps devices that have no friendly name in Zigbee2MQTT (dropped by default)
# DENSOR_CACHE_DIR=~/.cache/densor
# DENSOR_REFRESH=1               skip the cache for this run
# The bucket's hourly files are also kept as a local copy under DENSOR_CACHE_DIR/bucket, so only new hours are
# downloaded (in parallel). The uploader never rewrites an hour, so the copy never goes stale.
# DENSOR_MIRROR=0               read the bucket directly instead
# DENSOR_REFRESH_BUCKET=1       delete and re-download the local copy
