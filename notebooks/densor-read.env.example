# Copy to notebooks/.env (gitignored) and fill in a READ-ONLY Tigris key.
# Do not reuse the Pi's write key here.
S3_BUCKET=densor
# site=prefix pairs, one prefix per Pi
S3_SITES=ch=densor-ch,sr=densor-sr
S3_ENDPOINT=t3.storage.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
# Optional: read a local copy of the bucket layout instead of S3.
# DENSOR_LOCAL_DIR=/path/to/dir/containing/one/folder/per/prefix (each with readings/ and devices.json)
